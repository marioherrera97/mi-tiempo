<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="30sp" android:text="⛅" />
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#FFFFFF" android:textSize="34sp" android:text="–" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/w_place" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1"
                android:ellipsize="end" android:text="Mi Tiempo" />
            <TextView android:id="@+id/w_desc" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#A5B1C2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_maxmin" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E9EEF5" android:textSize="13sp" />
            <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#6E7B8C" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/w_rain" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="#4FA3FF" android:textSize="12sp" android:maxLines="1"
        android:ellipsize="end" android:text="Cargando…" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h0_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#A5B1C2" android:textSize="11sp" />
            <TextView android:id="@+id/h0_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView android:id="@+id/h0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E9EEF5" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h1_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#A5B1C2" android:textSize="11sp" />
            <TextView android:id="@+id/h1_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView android:id="@+id/h1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E9EEF5" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h2_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#A5B1C2" android:textSize="11sp" />
            <TextView android:id="@+id/h2_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView android:id="@+id/h2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E9EEF5" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h3_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#A5B1C2" android:textSize="11sp" />
            <TextView android:id="@+id/h3_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView android:id="@+id/h3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E9EEF5" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/h4_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#A5B1C2" android:textSize="11sp" />
            <TextView android:id="@+id/h4_icon" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" />
            <TextView android:id="@+id/h4_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E9EEF5" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
